# Homebrew Bundle - run with: brew bundle --global
# https://github.com/Homebrew/homebrew-bundle

# ─── CLI Tools ────────────────────────────────────────────────────────────────
# Cross-platform tools come from .chezmoidata.yaml (cliTools) so this list
# and the Linux apt list in run_onchange_01-install-deps.sh.tmpl can't drift
# apart -- add a tool there once, it shows up in both places.

{{ range .cliTools.always -}}
brew "{{ .brew }}" # {{ .desc }}
{{ end -}}
brew "chezmoi"          # Dotfile management
brew "starship"         # Prompt
brew "xcodes"           # Xcode version manager
{{ if .personal -}}
brew "speedtest-cli"    # Internet speed test
brew "direnv"           # Per-directory env
brew "node"             # Node.js
{{ range .cliTools.personal -}}
brew "{{ .brew }}" # {{ .desc }}
{{ end -}}
{{ end -}}

# ─── Fonts ────────────────────────────────────────────────────────────────────

cask "font-jetbrains-mono-nerd-font"

# ─── Applications ─────────────────────────────────────────────────────────────

cask "1password-cli"    # 1Password CLI
cask "firefox"          # Browser
cask "fork"             # Git GUI
cask "ghostty"          # Terminal
cask "sublime-text"     # Editor

{{ if .personal -}}
# Personal apps
cask "discord"          # Chat
cask "dropbox"          # File sync
cask "spotify"          # Music
cask "steam"            # Games
cask "vlc"              # Media player
cask "caffeine"         # Keep screen awake
{{ end -}}
